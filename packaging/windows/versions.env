# Pinned dependency versions for the Windows offline distribution.
# CI (build-dist.ps1) and install.bat both read these values.
# Bump carefully and re-run the windows-dist workflow after changes.

OPENCODE_VERSION=1.18.10
OH_MY_OPENCODE_VERSION=4.19.3
GLAB_VERSION=1.111.0

# Host Python used in CI to run pip download (any 3.10+ is fine)
PYTHON_VERSION=3.12

# Offline wheels are fetched for each of these CPython minor versions (win_amd64).
# install.bat accepts any installed Python >= PYTHON_MIN_VERSION.
PYTHON_MIN_VERSION=3.10
PYTHON_WHEEL_VERSIONS=3.10,3.11,3.12,3.13

NODE_VERSION=20
