# Pinned dependency versions for the Windows offline distribution.
# CI (build-dist.ps1) and the Windows installers read these values.
# Bump carefully and re-run the windows-dist workflow after changes.

OPENCODE_VERSION=1.18.10
# Official GitHub asset name — always the 64-bit AMD64 Windows CLI
OPENCODE_WINDOWS_ASSET=opencode-windows-x64.zip
OH_MY_OPENCODE_VERSION=4.19.3
GLAB_VERSION=1.111.0

# Official OpenAI Codex CLI (GitHub tag rust-vX.Y.Z). Same unattended worker as OpenCode.
# Windows AMD64 zip from https://github.com/openai/codex/releases
CODEX_VERSION=0.149.0
CODEX_WINDOWS_ASSET=codex-x86_64-pc-windows-msvc.exe.zip

# Host Python used in CI to run pip download (any 3.10+ is fine)
PYTHON_VERSION=3.12

# Offline wheels are fetched for each of these CPython minor versions (win_amd64).
# install-dashboard.bat only accepts versions that actually have complete wheels (see
# vendor/SUPPORTED_PYTHON.txt in the built dist). Python 3.14+ is tried in CI
# but omitted from support if packages like pydantic-core lack cp314 wheels yet.
PYTHON_MIN_VERSION=3.10
PYTHON_WHEEL_VERSIONS=3.10,3.11,3.12,3.13,3.14

NODE_VERSION=20
# Full Node win-x64 zip shipped under vendor/node for online OpenCode install
# (node.exe + npm). Bump together with NODE_VERSION when upgrading.
NODE_FULL_VERSION=20.19.0
