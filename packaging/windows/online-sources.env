# =============================================================================
# Optional download URL overrides for install-opencode-online.bat ONLY
# =============================================================================
# Not used by offline install-backends.bat.
# Leave empty to use the default public GitHub / GitLab / nodejs.org URLs.
# Point these at your HTTP-accessible FTP/file server mirrors when offline
# public internet is blocked.
#
# Example (HTTP gateway in front of FTP storage):
#   OPENCODE_ZIP_URL=http://files.example.com/vd/opencode-windows-x64-1.18.10.zip
#   GLAB_ZIP_URL=http://files.example.com/vd/glab_windows_amd64.zip
#   CODEX_ZIP_URL=http://files.example.com/vd/codex-package-x86_64-pc-windows-msvc.tar.gz
#   RG_ZIP_URL=http://files.example.com/vd/ripgrep-windows.zip
# =============================================================================

# OPENCODE_ZIP_URL=
# GLAB_ZIP_URL=
# RG_ZIP_URL=

# Optional: override registry without editing npm-online.npmrc
# (takes precedence over the registry= line in npm-online.npmrc)
# NPM_REGISTRY=http://npm.internal.example.com:4873/
