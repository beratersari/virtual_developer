{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [],
  "model": "custom/YOUR_MODEL",
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Custom host",
      "options": {
        "baseURL": "https://YOUR_HOST/v1",
        "apiKey": "YOUR_TOKEN"
      },
      "models": {
        "YOUR_MODEL": {
          "name": "YOUR_MODEL"
        }
      }
    }
  }
}
