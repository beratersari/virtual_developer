# =============================================================================
# npm config for install-opencode-online.bat ONLY
# =============================================================================
# This file is copied to %USERPROFILE%\.opencode\.npmrc before npm install.
# It does NOT affect offline install.bat (that path never runs npm).
#
# Edit "registry=" to your private npm-compatible mirror.
# npm speaks HTTP/HTTPS registry protocol (not raw FTP). If packages live on
# an FTP host, expose them via HTTP (IIS/nginx/Caddy) or an npm proxy such as
# Verdaccio pointing at your storage, then put that URL here.
#
# Examples:
#   registry=https://registry.npmjs.org/
#   registry=http://npm.internal.example.com:4873/
#   registry=http://fileserver.example.com/npm/
#
# Optional auth (uncomment and fill):
# //npm.internal.example.com:4873/:_authToken=YOUR_TOKEN
# //fileserver.example.com/npm/:username=user
# //fileserver.example.com/npm/:_password=base64password
# always-auth=true
#
# TLS (self-signed mirrors):
# strict-ssl=false
# =============================================================================

registry=https://registry.npmjs.org/
