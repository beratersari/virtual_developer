# Pinned versions for the standalone Yaver executable (PyInstaller).
# CI (.github/workflows/executables.yml) and packaging/pyinstaller/build.py
# read these values. Bump carefully and re-run Standalone Executables.

# Host Python used to freeze on Windows (must match a CPython the wheels support)
PYTHON_VERSION=3.12

# Linux freeze uses this python-build-standalone install_only tarball
# inside each Ubuntu container (18.04 has no distro Python 3.12).
# https://github.com/astral-sh/python-build-standalone/releases/tag/20260901
PYTHON_STANDALONE_RELEASE=20260901
PYTHON_STANDALONE_ASSET=cpython-3.12.14+20260901-x86_64-unknown-linux-gnu-install_only.tar.gz
PYTHON_STANDALONE_SHA256=936c246dfdbbfa7cb22dd01814a21f582a892689fae96b06071a5e433baffa22

# Node used to build web/dist before freeze
NODE_VERSION=20

# PyInstaller release: https://pypi.org/project/pyinstaller/
PYINSTALLER_VERSION=6.16.0

# onedir (folder + yaver.exe / yaver) is the supported layout.
# onefile is slower to start and extracts to temp on every launch.
PYINSTALLER_MODE=onedir
