# Pinned versions for the standalone Yaver executable (PyInstaller).
# CI (.github/workflows/executables.yml) and packaging/pyinstaller/build.py
# read these values. Bump carefully and re-run Standalone Executables.

# Host Python used to freeze (must match a CPython the wheels support)
PYTHON_VERSION=3.12

# Node used to build web/dist before freeze
NODE_VERSION=20

# PyInstaller release: https://pypi.org/project/pyinstaller/
PYINSTALLER_VERSION=6.16.0

# onedir (folder + yaver.exe / yaver) is the supported layout.
# onefile is slower to start and extracts to temp on every launch.
PYINSTALLER_MODE=onedir
