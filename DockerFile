FROM python:3.13

WORKDIR /app

# Gerekli sistem paketleri
RUN apt-get update && apt-get install -y \
    curl \
    git \
    build-essential \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Tüm projeyi kopyala
COPY . .

# Script executable
RUN chmod +x install.sh

# Install script çalıştır
RUN ./install.sh

# PATH fix (opencode için)
ENV PATH="/root/.opencode/bin:${PATH}"

CMD ["/bin/bash"]
