DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin
JIRA_HOST=https://your-jira.example.com
JIRA_API_TOKEN=your-api-token-here
JIRA_PROJECTS=KAN
JIRA_BOARD_ID=1
GITLAB_HOST_PATS=
GITLAB_WEBHOOK_SECRET=change-me-gitlab-webhook-secret
GITLAB_TRIGGER_USER=berat_ai
AZURE_HOST_PATS=
AZURE_WEBHOOK_SECRET=change-me-azure-webhook-secret
AZURE_TRIGGER_USER=yaver
JIRA_TRIGGER_USER=jira ai bot, jira-ai-bot, jiraai, devbot

# =============================================================================
# Yaver — Environment Template
# =============================================================================
#   cp .env.example .env
#   Edit the keys at the top for your Jira / GitLab site.
#
# Auth: JIRA_HOST + JIRA_API_TOKEN (Bearer). Cloud Basic email is optional
# at the bottom of this file.
# Dashboard login: set both DASHBOARD_USERNAME and DASHBOARD_PASSWORD at the
# top. Leave empty for no login. This does not apply to the board poller or
# POST /webhooks/gitlab or POST /webhooks/azure.
#
# Do not commit .env (secrets). This file must stay free of real tokens.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) INTAKE — board poller (To Do + bot assignee)
# -----------------------------------------------------------------------------
# The board poller is the only Jira intake. Bot name is JIRA_TRIGGER_USER
# at the top (assignee match and @mentions). Comma-separated for more than one.
POLL_INTERVAL_SECONDS=30
# How many agent jobs run at the same time (raise for large boards / many subtasks)
MAX_CONCURRENT_JOBS=3
# Parallel Jira dispatch/transitions per poll cycle (not agent concurrency)
POLL_DISPATCH_WORKERS=8

# Ops dashboard (no auth in v1)
DASHBOARD_ENABLED=true
# 0.0.0.0 = all interfaces (LAN). Use 127.0.0.1 to lock to this machine only.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Required true when DASHBOARD_HOST is not loopback (default true in code).
DASHBOARD_ALLOW_REMOTE=true


# -----------------------------------------------------------------------------
# 2) GITLAB AUTH — repository + branch come from each Jira issue
# -----------------------------------------------------------------------------
# GITLAB_HOST_PATS is at the top. A host with a PAT is allowed.
#   GITLAB_HOST_PATS={"gitlab.com":"glpat-…","gitlab.internal.example.com":"glpat-…"}
# Leftover when the map is empty: GITLAB_PAT + GITLAB_ALLOWED_HOSTS expands
# that one PAT onto those hosts.

# Clone + submodule budgets (large monorepos / many nested modules)
GIT_CLONE_TIMEOUT_SECONDS=1800
GIT_SUBMODULE_TIMEOUT_SECONDS=1800
# true = run `git submodule update --init --recursive` after clone and again
# after the work branch is checked out (recommended when repos use submodules)
GIT_UPDATE_SUBMODULES=true

# Each Jira issue description must include a {params} block:
#   {params}
#   Repository: https://gitlab.example.com/group/repo.git
#   Source branch: feature/PROJ-123   # work branch (MR source); use develop to auto feature/{KEY}
#   Target branch: develop            # must exist; work branch is created FROM this; MR merges INTO it
#   {params}


# -----------------------------------------------------------------------------
# 3) GITLAB MR COMMENT WEBHOOK — tag the bot on an MR to start a job
# -----------------------------------------------------------------------------
# Project hook: Comments + Merge request events.
# URL: http://<this-host>:8080/webhooks/gitlab
# Secret: GITLAB_WEBHOOK_SECRET (X-Gitlab-Token; set at the top).
# Merged or closed MRs delete the matching temp clone.
GITLAB_WEBHOOK_ENABLED=true


# -----------------------------------------------------------------------------
# 3b) AZURE DEVOPS SERVER 2022.2 PR COMMENT WEBHOOK — same usage as GitLab
# -----------------------------------------------------------------------------
# Project service hook: Pull request commented + Pull request updated/merged.
# URL: http://<this-host>:8080/webhooks/azure
# Secret: AZURE_WEBHOOK_SECRET (X-Azure-Token, or Basic password).
# Clone/push use the Azure PAT only — empty username + PAT, never a prompt.
#   AZURE_HOST_PATS={"tfs.example.com":"your-azure-pat"}
# Completed or abandoned PRs delete the matching temp clone.
AZURE_WEBHOOK_ENABLED=true


# -----------------------------------------------------------------------------
# 4) AGENT / OPENCODE RUNTIME
# -----------------------------------------------------------------------------
# OpenCode binary on PATH (TUI / `opencode models`). Agent jobs always use serve.
OPENCODE_CLI=opencode
# start-backend.bat / start.bat start this if http://127.0.0.1:4096/global/health is down.
OPENCODE_SERVE_URL=http://127.0.0.1:4096

# Default model id for agent runs (OpenCode and Codex).
# List options: `python cli.py models` or dashboard Settings / GET /api/models
# Provider/auth stay in each tool's own config (opencode.json, ~/.codex/config.toml).
DEFAULT_MODEL=GLM
# Unattended worker: opencode (default) or codex. Per-issue {params} Backend: wins.
AGENT_BACKEND=opencode
# Codex CLI (only used when AGENT_BACKEND=codex).
CODEX_CLI=codex

# OpenCoderman agents (not stock OpenCode build/plan).
DEFAULT_AGENT=derman-build
DEFAULT_PLAN_AGENT=derman-plan


# -----------------------------------------------------------------------------
# 5) TEMP WORKSPACES & DURABLE DATA (not under the install folder)
# -----------------------------------------------------------------------------
# Each issue clones into: {TEMP_DIR_BASE}/{remote12}_{hash12}/
#   Windows / WSL:  C:\vd\t          (WSL also accepts /mnt/c/vd/t)
#   Native Linux:   /vd/t            (or ~/vd/t if /vd is not writable)
# Keep the path short on Windows (MAX_PATH 260).
TEMP_DIR_BASE=C:\vd\t

# Sessions, jobs, state, OpenCode binds, runtime_settings.json, plans/
#   Windows / WSL:  C:\vd\yaver      (WSL: /mnt/c/vd/yaver)
#   Native Linux:   /vd/yaver        (or ~/vd/yaver if /vd is not writable)
# Plans: {YAVER_DATA_DIR}/plans/{ISSUE_KEY}.md (never inside the clone).
YAVER_DATA_DIR=C:\vd\yaver

# Temp clones under TEMP_DIR_BASE are kept. Delete them from dashboard Storage.


# -----------------------------------------------------------------------------
# 6) AGENT TASK TIMEOUTS & RETRIES
# -----------------------------------------------------------------------------
# Wall-clock seconds per OpenCode serve attempt. Also editable in Settings
# (runtime wins; not written back to .env).
AGENT_TASK_TIMEOUT_SECONDS=1800
AGENT_TASK_MAX_RETRIES=3
AGENT_TASK_RETRY_DELAY_SECONDS=5
AGENT_TASK_RETRY_BACKOFF_MULTIPLIER=2.0
AGENT_TASK_RETRY_ON_TIMEOUT=true
AGENT_TASK_RETRY_ON_ERROR=true
# Incomplete-session retries after compact is waited out. Independent of
# MAX_RETRIES. 0 = only use MAX_RETRIES.
AGENT_TASK_MAX_INCOMPLETE_RETRIES=256


# -----------------------------------------------------------------------------
# 7) OPTIONAL — Jira Cloud Basic (not used in daily on-prem / Bearer)
# -----------------------------------------------------------------------------
# Set only if you later use an Atlassian Cloud API token (HTTP Basic).
# Leave empty to keep Bearer PAT.
JIRA_EMAIL=
