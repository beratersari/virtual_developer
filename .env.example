# =============================================================================
# JIRA Virtual Developer — Environment Template
# =============================================================================
# Setup:
#   cp .env.example .env
#   Edit every line marked  #EDIT HERE  for your project/environment.
#
# Auth:
#   Prod / on-prem PAT  →  JIRA_HOST + JIRA_API_TOKEN          (Bearer)
#   Cloud API token     →  JIRA_HOST + JIRA_EMAIL + token      (Basic)
#                          (leave JIRA_EMAIL empty for Bearer)
#
# Do not commit .env (secrets). This file must stay free of real tokens.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) JIRA CONNECTION  — change for every Jira site / project  #EDIT HERE
# -----------------------------------------------------------------------------
# Site base URL (no trailing slash preferred)
JIRA_HOST=https://your-jira.example.com                          #EDIT HERE

# Cloud API token only: Atlassian account email (Basic auth). Leave empty for
# Bearer PAT (prod / on-prem).
JIRA_EMAIL=                                                      #EDIT HERE (Cloud dev)

# Cloud API token OR on-prem personal access token
JIRA_API_TOKEN=your-api-token-here                               #EDIT HERE

# Comma-separated project keys this bot is allowed to handle
JIRA_PROJECTS=KAN                                                #EDIT HERE

# Board id (from board URL or GET /rest/agile/1.0/board?projectKeyOrId=KEY)
# Example: Cloud "KAN board" is often id=1 (not a random large number)
JIRA_BOARD_ID=1                                                  #EDIT HERE


# -----------------------------------------------------------------------------
# 2) INTAKE — board poller (always on; sole discovery path)
# -----------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=30                                         #EDIT HERE
# How many agent jobs run at the same time (raise for large boards / many subtasks)
MAX_CONCURRENT_JOBS=6                                            #EDIT HERE
# Parallel Jira dispatch/transitions per poll cycle (not agent concurrency)
POLL_DISPATCH_WORKERS=8                                          #EDIT HERE

# Ops dashboard (no auth in v1)
DASHBOARD_ENABLED=true
# 0.0.0.0 = all interfaces (LAN). Use 127.0.0.1 to lock to this machine only.
DASHBOARD_HOST=0.0.0.0                                           #EDIT HERE
DASHBOARD_PORT=8080                                              #EDIT HERE
# Required true when DASHBOARD_HOST is not loopback (default true in code).
DASHBOARD_ALLOW_REMOTE=true


# -----------------------------------------------------------------------------
# 3) TRIGGERS — which issues the bot accepts  #EDIT HERE
# -----------------------------------------------------------------------------
# Process when issue has any of these labels (comma-separated)
TRIGGER_LABELS=ai-assist,bot                                     #EDIT HERE

# Process when assignee display name looks like the bot (poller name match)
TRIGGER_ON_ASSIGNMENT=true

# Comma-separated fragments matched (case-insensitive substring) against
# assignee displayName / name / key. Include your real bot account name.
# Example: DevBot,Jira AI Bot,my-service-account
TRIGGER_ASSIGNEE_NAMES=jira ai bot,jira-ai-bot,jiraai,devbot     #EDIT HERE

# Optional @mention strings for free-form comment commands (not board intake)
TRIGGER_MENTIONS=@DevBot,@AI                                     #EDIT HERE


# -----------------------------------------------------------------------------
# 4) GITLAB AUTH — repository + branch come from each Jira issue  #EDIT HERE
# -----------------------------------------------------------------------------
# Preferred: per-host PATs (JSON). Clone/push/MR picks the PAT for the repo host.
# GITLAB_HOST_PATS={"gitlab.com":"glpat-…","gitlab.internal.example.com":"glpat-…"}
GITLAB_HOST_PATS=                                                #EDIT HERE

# Single-host form: one PAT + hosts that may receive it (same PAT for each host).
# REQUIRED when using GITLAB_PAT alone: comma-separated hostnames only.
# Issue Repository URLs on other hosts will be refused (prevents PAT exfiltration).
GITLAB_PAT=your-gitlab-pat                                       #EDIT HERE
GITLAB_ALLOWED_HOSTS=gitlab.example.com                          #EDIT HERE

# Commit identity used inside the temp clone
GIT_USER_NAME=DevBot                                             #EDIT HERE
GIT_USER_EMAIL=devbot@example.com                                #EDIT HERE

# Clone + submodule budgets (large monorepos / many nested modules)
# Defaults: 1800s (30 min) each — raise if clones still time out.
# Job logs record start/end only (not live git progress).
GIT_CLONE_TIMEOUT_SECONDS=1800
GIT_SUBMODULE_TIMEOUT_SECONDS=1800
# true = run `git submodule update --init --recursive` after clone and again
# after the work branch is checked out (recommended when repos use submodules)
GIT_UPDATE_SUBMODULES=true

# Each Jira issue description must include a {params} block (see src/issue_git_spec.py):
#   {params}
#   Repository: https://gitlab.example.com/group/repo.git
#   Source branch: feature/PROJ-123   # work branch (MR source); use develop to auto feature/{KEY}
#   Target branch: develop            # must exist; work branch is created FROM this; MR merges INTO it
#   {params}
# Flow: require target on remote → create/reset work branch from target → work → MR source → target


# -----------------------------------------------------------------------------
# 5) AGENT / OPENCODE RUNTIME
# -----------------------------------------------------------------------------
# CLI used to run agents (must be on PATH or absolute)
OPENCODE_CLI=opencode                                            #EDIT HERE

# Default model id for agent runs (provider/model). Passed to `opencode run --model`.
# List options: `python cli.py models` or dashboard Settings / GET /api/models
# Also merges models declared in ~/.config/opencode/opencode.json(c) provider blocks.
DEFAULT_MODEL=ollama/Qwen3.5-397B-A17B-FP8                       #EDIT HERE

# Single OpenCode agent for plan and build (mode selects PLAN vs BUILD prompt text).
# Oracle consult still uses agent "oracle". Examples: atlas, sisyphus, prometheus.
DEFAULT_AGENT=atlas                                              #EDIT HERE


# -----------------------------------------------------------------------------
# 6) PROMPTS (paths relative to process CWD unless absolute)
# -----------------------------------------------------------------------------
# Mode prompts only (agent name does not change text):
#   agent/PLAN_PROMPT.md  — Mode: plan
#   agent/BUILD_PROMPT.md — Mode: build
# AGENT_PROMPTS_DIR=agent
# PLAN_PROMPT_FILE=
# BUILD_PROMPT_FILE=

# Where planning agents write plan markdown
SISYPHUS_PLANS_DIR=.sisyphus/plans


# -----------------------------------------------------------------------------
# 7) TEMP WORKSPACES & CLEANUP (temp clones are always mandatory)
# -----------------------------------------------------------------------------
# Each issue clones into: {TEMP_DIR_BASE}/{remote}_{issue}_{timestamp}/
# Requires Repository + Source + Target branch on the issue (+ GitLab PAT).
TEMP_DIR_BASE=.temp

# age = delete clones older than TEMP_CLEANUP_MAX_AGE_DAYS (default 1 = 24h)
#       also swept on daemon start + hourly while running
# always = delete each clone when the job ends
# on_success = delete only when the job succeeded
# never = keep all temp clones
TEMP_CLEANUP_POLICY=age
TEMP_CLEANUP_MAX_AGE_DAYS=1

# Session logs under .jira-agent/sessions/ are NEVER deleted by cleanup


# -----------------------------------------------------------------------------
# 8) AGENT TASK TIMEOUTS & RETRIES
# -----------------------------------------------------------------------------
# Wall-clock seconds per OpenCode/agent attempt (default 1800 = 30 minutes).
# Agent runner and OpenCode CLI share this single budget (orchestrator kills
# the process at the limit). Also editable at runtime in the ops dashboard
# Settings page (not written back to .env).
AGENT_TASK_TIMEOUT_SECONDS=1800
AGENT_TASK_MAX_RETRIES=3
AGENT_TASK_RETRY_DELAY_SECONDS=5
AGENT_TASK_RETRY_BACKOFF_MULTIPLIER=2.0
AGENT_TASK_RETRY_ON_TIMEOUT=true
AGENT_TASK_RETRY_ON_ERROR=true


# -----------------------------------------------------------------------------
# 8b) AGENT CHILD ENV (simple pass-through)
# -----------------------------------------------------------------------------
# OpenCode gets the process env except:
#   - name contains: _PASSWORD, _SECRET, _TOKEN, _API_KEY, PRIVATE_KEY
#   - host bot secrets: JIRA_*, GITLAB_PAT/TOKEN/HOST_PATS, SSH_*, VD_GIT_*
# Model provider keys (OPENAI_API_KEY, …) still pass.
# Non-secret build vars (PATH, INCLUDE, LIB, MSVC, MVCC_*, CMAKE_*, …) pass.
# Put needed keys in this .env (loaded at startup); avoid *TOKEN* names if the
# agent must see them (or rename to e.g. NPM_AUTH / REGISTRY_AUTH_VALUE).


# -----------------------------------------------------------------------------
# 9) WORKFLOW
# -----------------------------------------------------------------------------
# Plans never auto-start (intentional product choice).
# After plan_ready: open a NEW issue with Mode: build, or add label
# ai-start-work / ai-execute on the plan ticket while it is To Do.
# MAX_CONCURRENT_JOBS / POLL_DISPATCH_WORKERS — see section 2 (intake)


# -----------------------------------------------------------------------------
# 10) LOGGING & LOCAL PATHS
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=logs/jira-agent.log

# Local sample project path for cli.py test-issue without GitLab
PROJECT_ROOT=sample_project
