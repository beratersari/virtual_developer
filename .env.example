# =============================================================================
# JIRA Virtual Developer — Environment Template
# =============================================================================
# Setup:
#   cp .env.example .env
#   Edit .env for your project/environment.
#
# Auth:
#   Prod / on-prem PAT  →  JIRA_HOST + JIRA_API_TOKEN          (Bearer)
#   Cloud API token     →  JIRA_HOST + JIRA_EMAIL + token      (Basic)
#                          (leave JIRA_EMAIL empty for Bearer)
#
# Do not commit .env (secrets). This file must stay free of real tokens.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) JIRA CONNECTION  — change for every Jira site / project
# -----------------------------------------------------------------------------
# Site base URL (no trailing slash preferred)
JIRA_HOST=https://your-jira.example.com

# Cloud API token only: Atlassian account email (Basic auth). Leave empty for
# Bearer PAT (prod / on-prem).
JIRA_EMAIL=

# Cloud API token OR on-prem personal access token
JIRA_API_TOKEN=your-api-token-here

# Comma-separated project keys this bot is allowed to handle
JIRA_PROJECTS=KAN

# Board id (from board URL or GET /rest/agile/1.0/board?projectKeyOrId=KEY)
# Example: Cloud "KAN board" is often id=1 (not a random large number)
JIRA_BOARD_ID=1


# -----------------------------------------------------------------------------
# 2) INTAKE — poll (board) or webhook (assignment + mention)
# -----------------------------------------------------------------------------
# poll    = board/sprint poller (default; existing behaviour)
# webhook = POST /webhooks/jira only (poller sleeps). Register on Jira:
#           Issue created, Issue updated, Comment created.
#           Server 9.4 has no HMAC — put the token in the URL:
#           http://<this-host>:8080/webhooks/jira?token=JIRA_WEBHOOK_SECRET
# Dashboard Settings can switch this at runtime (also written back here).
JIRA_INTAKE_MODE=poll
JIRA_WEBHOOK_SECRET=
POLL_INTERVAL_SECONDS=30
# How many agent jobs run at the same time (raise for large boards / many subtasks)
MAX_CONCURRENT_JOBS=6
# Parallel Jira dispatch/transitions per poll cycle (not agent concurrency)
POLL_DISPATCH_WORKERS=8

# Ops dashboard (no auth in v1)
DASHBOARD_ENABLED=true
# 0.0.0.0 = all interfaces (LAN). Use 127.0.0.1 to lock to this machine only.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Required true when DASHBOARD_HOST is not loopback (default true in code).
DASHBOARD_ALLOW_REMOTE=true


# -----------------------------------------------------------------------------
# 3) TRIGGERS — which issues the bot accepts
# -----------------------------------------------------------------------------
# Poller starts a job only when BOTH are true (To Do-like status as well):
#   1) issue has one of these labels
#   2) assignee matches TRIGGER_ASSIGNEE_NAMES
TRIGGER_LABELS=ai-assist,bot

# Webhook: also fire when the ticket is assigned to the bot (poller still
# requires label AND assignee). Unassign does not start work.
TRIGGER_ON_ASSIGNMENT=true

# Comma-separated fragments matched (case-insensitive substring) against
# assignee displayName / name / key. Include your real bot account name.
# Example: DevBot,Jira AI Bot,my-service-account
TRIGGER_ASSIGNEE_NAMES=jira ai bot,jira-ai-bot,jiraai,devbot

# Optional @mention strings. In webhook mode a comment must mention one of
# these (or wiki [~user] matching TRIGGER_ASSIGNEE_NAMES) to start a job.
TRIGGER_MENTIONS=@DevBot,@AI


# -----------------------------------------------------------------------------
# 4) GITLAB AUTH — repository + branch come from each Jira issue
# -----------------------------------------------------------------------------
# Preferred: per-host PATs (JSON). Clone/push/MR picks the PAT for the repo host.
# GITLAB_HOST_PATS={"gitlab.com":"glpat-…","gitlab.internal.example.com":"glpat-…"}
GITLAB_HOST_PATS=

# Optional saved remotes for Scheduled → New issue. Prefer Settings → Projects
# (runtime). JSON list of {label,url,target_branch,source_branch}.
# PROJECT_REPOSITORIES=[{"label":"demo","url":"https://gitlab.com/g/r.git","target_branch":"develop"}]

# Single-host form: one PAT + hosts that may receive it (same PAT for each host).
# REQUIRED when using GITLAB_PAT alone: comma-separated hostnames only.
# Issue Repository URLs on other hosts will be refused (prevents PAT exfiltration).
GITLAB_PAT=your-gitlab-pat
GITLAB_ALLOWED_HOSTS=gitlab.example.com

# Commit identity used inside the temp clone
GIT_USER_NAME=DevBot
GIT_USER_EMAIL=devbot@example.com

# Clone + submodule budgets (large monorepos / many nested modules)
# Defaults: 1800s (30 min) each — raise if clones still time out.
# Job logs record start/end only (not live git progress).
GIT_CLONE_TIMEOUT_SECONDS=1800
GIT_SUBMODULE_TIMEOUT_SECONDS=1800
# true = run `git submodule update --init --recursive` after clone and again
# after the work branch is checked out (recommended when repos use submodules)
GIT_UPDATE_SUBMODULES=true

# Each Jira issue description must include a {params} block (see src/issue_git_spec.py):
#   {params}
#   Repository: https://gitlab.example.com/group/repo.git
#   Source branch: feature/PROJ-123   # work branch (MR source); use develop to auto feature/{KEY}
#   Target branch: develop            # must exist; work branch is created FROM this; MR merges INTO it
#   {params}
# Flow: require target on remote → create/reset work branch from target → work → MR source → target


# -----------------------------------------------------------------------------
# 4b) GITLAB MR COMMENT WEBHOOK  — tag the bot on an MR to start a job
# -----------------------------------------------------------------------------
# Register a **project** webhook (works on GitLab.com free, CE, and EE):
#   URL:    http://<this-host>:8080/webhooks/gitlab
#   Events: Comments (Note events) only
#   Secret: GITLAB_WEBHOOK_SECRET  (sent as X-Gitlab-Token)
# Group webhooks are EE-only; use the project hook on basic/CE.
GITLAB_WEBHOOK_ENABLED=true
GITLAB_WEBHOOK_SECRET=change-me-gitlab-webhook-secret
# Comment must mention one of these (e.g. "@berat_ai please fix the login bug").
# Mentions run as **build** on the MR source branch (may edit/commit/push; reply on the MR).
GITLAB_BOT_MENTIONS=@berat_ai
# GitLab account username(s) of this bot — own notes are ignored (loop guard)
GITLAB_BOT_USERNAMES=berat_ai


# -----------------------------------------------------------------------------
# 5) AGENT / OPENCODE RUNTIME
# -----------------------------------------------------------------------------
# OpenCode binary on PATH (TUI / `opencode models`). Agent jobs always use serve.
OPENCODE_CLI=opencode
# start-backend.bat / start.bat start this if http://127.0.0.1:4096/global/health is down.
OPENCODE_SERVE_URL=http://127.0.0.1:4096
# Compact-then-stop is NOT an error — serve waits on the same session
# with no compact-continue cap (only AGENT_TASK_TIMEOUT_SECONDS bounds the job).

# Default model id for agent runs (OpenCode and Codex). Passed as model=.
# List options: `python cli.py models` or dashboard Settings / GET /api/models
# Provider/auth stay in each tool's own config (opencode.json, ~/.codex/config.toml).
DEFAULT_MODEL=GLM
# Unattended worker: opencode (default) or codex. Per-issue {params} Backend: wins.
AGENT_BACKEND=opencode
# Codex CLI (only used when AGENT_BACKEND=codex). Same job contract as OpenCode.
# Windows: install-codex.bat extracts vendor\codex-package-x86_64-pc-windows-msvc.tar.gz
# with tar.exe only (or downloads that same asset). It does not use vendor\bin\codex.exe.
# Installs to %LOCALAPPDATA%\Programs\OpenAI\Codex\bin\codex.exe
# and seeds %USERPROFILE%\.codex\config.toml when missing.
# Configure Codex providers/auth in ~/.codex/config.toml (not here).
CODEX_CLI=codex
# Job-local context cap written to the clone's opencode.json (0 = native window).
# 32k compact/restore-loops on long jobs. 128k is the default. hy3-free is 190k.
OPENCODE_CONTEXT_LIMIT=128000


ASELIXAI_API_KEY=your-aselixai-api-key
# OpenCoderman agents (not stock OpenCode build/plan).
# Mode: build  → DEFAULT_AGENT=derman-build
# Mode: plan   → DEFAULT_PLAN_AGENT=derman-plan
# Oracle consult still uses agent "oracle".
DEFAULT_AGENT=derman-build
DEFAULT_PLAN_AGENT=derman-plan


# -----------------------------------------------------------------------------
# 6) PROMPTS (paths relative to process CWD unless absolute)
# -----------------------------------------------------------------------------
# Short per-job user stubs (stable rules live on the OpenCoderman agents):
#   agent/PLAN_PROMPT.md  — Mode: plan job facts
#   agent/BUILD_PROMPT.md — Mode: build job facts + git subject format
# AGENT_PROMPTS_DIR=agent
# PLAN_PROMPT_FILE=
# BUILD_PROMPT_FILE=

# Where planning agents write plan markdown
SISYPHUS_PLANS_DIR=.sisyphus/plans


# -----------------------------------------------------------------------------
# 7) TEMP WORKSPACES & DURABLE DATA (not under the install folder)
# -----------------------------------------------------------------------------
# Live data is NOT .jira-agent/ or .temp/ next to the repo. Those names are
# leftover/legacy (pytest, or a one-time migrate into YAVER_DATA_DIR).
#
# Each issue clones into: {TEMP_DIR_BASE}/{remote12}_{hash12}/
#   Windows / WSL:  C:\vd\t          (WSL also accepts /mnt/c/vd/t)
#   Native Linux:   /vd/t            (or ~/vd/t if /vd is not writable)
# A C:\… value on native Linux is remapped to /vd/… (or ~/vd/…).
# Keep the path short on Windows (MAX_PATH 260).
# Requires Repository + Source + Target branch on the issue (+ GitLab PAT).
TEMP_DIR_BASE=C:\vd\t
# TEMP_DIR_BASE=/vd/t

# Sessions, jobs, state, OpenCode binds, runtime_settings.json
#   Windows / WSL:  C:\vd\yaver      (WSL: /mnt/c/vd/yaver)
#   Native Linux:   /vd/yaver        (or ~/vd/yaver if /vd is not writable)
# Same remap: C:\vd\yaver on native Linux → /vd/yaver or ~/vd/yaver.
YAVER_DATA_DIR=C:\vd\yaver
# YAVER_DATA_DIR=/vd/yaver

# Temp clones under TEMP_DIR_BASE are kept. Delete them from dashboard Storage.
# Session logs under YAVER_DATA_DIR/sessions/ are never auto-deleted.


# -----------------------------------------------------------------------------
# 8) AGENT TASK TIMEOUTS & RETRIES
# -----------------------------------------------------------------------------
# Wall-clock seconds per OpenCode serve attempt (default 1800 = 30 minutes).
# The orchestrator aborts the session at the limit. Also editable at runtime
# in the ops dashboard Settings page (not written back to .env).
AGENT_TASK_TIMEOUT_SECONDS=1800
AGENT_TASK_MAX_RETRIES=3
AGENT_TASK_RETRY_DELAY_SECONDS=5
AGENT_TASK_RETRY_BACKOFF_MULTIPLIER=2.0
AGENT_TASK_RETRY_ON_TIMEOUT=true
AGENT_TASK_RETRY_ON_ERROR=true
# Incomplete-session retries after compact is waited out. Independent of
# MAX_RETRIES. 0 = only use MAX_RETRIES.
# Also writable on the ops dashboard (Settings → Runtime); dashboard wins.
AGENT_TASK_MAX_INCOMPLETE_RETRIES=256


# -----------------------------------------------------------------------------
# 8b) AGENT CHILD ENV (full process + PC environment)
# -----------------------------------------------------------------------------
# Jobs inherit every process env var (this .env plus the OS environment).
# No name-based allow/deny filter. On Windows / WSL, User + Machine vars
# from System Properties are also merged (e.g. CODEX_API_KEY, OPENAI_API_KEY).
# Already-set process values win; empty keys are filled from the PC env.
# Restart the daemon (or start a new job) after changing System Properties.


# -----------------------------------------------------------------------------
# 9) WORKFLOW
# -----------------------------------------------------------------------------
# Plans never auto-start (intentional product choice).
# After plan_ready: open a NEW issue with Mode: build, or add label
# ai-start-work / ai-execute on the plan ticket while it is To Do.
# MAX_CONCURRENT_JOBS / POLL_DISPATCH_WORKERS — see section 2 (intake)


# -----------------------------------------------------------------------------
# 10) LOCAL PATHS
# -----------------------------------------------------------------------------
# Local sample project path for cli.py test-issue without GitLab
PROJECT_ROOT=sample_project