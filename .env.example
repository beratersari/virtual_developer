# JIRA Virtual Developer - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# JIRA Configuration (Required for real JIRA integration)
# =============================================================================
JIRA_HOST=
JIRA_API_TOKEN=your-api-token-here  #EDIT HERE
JIRA_PROJECTS=VOLKAN
JIRA_BOARD_ID=4816
ENABLE_WEBHOOK=false 
ENABLE_POLLING=true
POLL_INTERVAL_SECONDS=30

# =============================================================================
# Webhook Configuration
# =============================================================================
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/jira
# WEBHOOK_SECRET=your-secret-key-here  # Uncomment for webhook signature verification

# =============================================================================
# Oh My OpenAgent Configuration
# =============================================================================
OPENCODE_CLI=opencode
PROJECT_ROOT=sample_project
SISYPHUS_PLANS_DIR=.sisyphus/plans

# =============================================================================
# Git Configuration (for commits in target project folder)
# =============================================================================
GIT_USER_NAME=DevBot
GIT_USER_EMAIL=devbot@example.com

# Remote GitLab repository (optional)
# If set, will clone repo into PROJECT_ROOT and enable push/merge-request features
PROJECT_GITLAB_URL= #EDIT HERE kullanmak istediğiniz projenin linkini koyun
GITLAB_PAT=your-gitlab-pat  #EDIT HERE proje için yetkisi olan bir pat giriniz.

# =============================================================================
# Agent Configuration
# =============================================================================
# Default agent for direct task execution
# Options: sisyphus, hephaestus, prometheus, atlas, oracle, explore, librarian, metis, momus
DEFAULT_AGENT=sisyphus

# Agent used for planning complex tasks
# Options: sisyphus, prometheus, metis, oracle
PLANNING_AGENT=prometheus

# Agent used for orchestrating multi-step plans
# Options: atlas, sisyphus
ORCHESTRATOR_AGENT=atlas

# Default category for task execution
# Options: quick, deep, visual-engineering, ultrabrain, artistry, writing, unspecified-low, unspecified-high
EXECUTION_CATEGORY=deep

# =============================================================================
# Prompt File Configuration
# =============================================================================
# Prompts are loaded from markdown files. You can customize the paths here.
# If the file doesn't exist, built-in defaults will be used.

# Asagidaki pathler clone'lanan projenin içinden okunuyor. Eğer ilgili pathi bulamazsa default bir system prompt okunuyor
# Projenize uygun kod yazması için bunları editlemeniz iyi olur.
# Path to planning prompt (used by Prometheus for creating work plans)
PROMPT_PLANNING_FILE=agent/prompts/PLANNING.md

# Path to execution prompt (used by Atlas for orchestrating plan execution)
PROMPT_EXECUTION_FILE=agent/prompts/EXECUTION.md

# Path to direct execution prompt (used by Sisyphus for simple tasks)
PROMPT_DIRECT_EXECUTION_FILE=agent/prompts/DIRECT_EXECUTION.md

# Path to oracle prompt (used by Oracle for architecture consultation)
PROMPT_ORACLE_FILE=agent/prompts/ORACLE.md

# =============================================================================
# Code Review Configuration
# =============================================================================
# After a successful coding step the system automatically runs a code review
# using oh-my-openagent with the model and agent configured below.

# Agent to run for code review (default: momus)
# Options: momus, sisyphus, oracle, explore
CODE_REVIEW_AGENT=momus

# CODE_REVIEW_MODEL= bunu input olarak alıyorum ama opencode'a göndermeme rağmen set etmiyor nedense çözülecek.

# Path to code review prompt/rules
CODE_REVIEW_PROMPT_FILE=agent/rules/CODE_REVIEW.md

# =============================================================================
# Feature Flags
# =============================================================================
AUTO_START_PLANS=false
MAX_CONCURRENT_JOBS=3


# =============================================================================
# Agent Task Timeout & Retry Configuration
# =============================================================================
# Maximum time in seconds for an agent task to complete (default: 1800 = 30 minutes)
AGENT_TASK_TIMEOUT_SECONDS=1800

# Maximum number of retry attempts for failed agent tasks (default: 3)
AGENT_TASK_MAX_RETRIES=3

# Initial delay in seconds between retry attempts (default: 5)
AGENT_TASK_RETRY_DELAY_SECONDS=5

# Exponential backoff multiplier for retries (default: 2.0)
# Delay pattern: 5s, 10s, 20s, 40s, etc.
AGENT_TASK_RETRY_BACKOFF_MULTIPLIER=2.0

# Whether to retry tasks that timeout (default: true)
AGENT_TASK_RETRY_ON_TIMEOUT=true

# Whether to retry tasks that fail with errors (default: true)
AGENT_TASK_RETRY_ON_ERROR=true


# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# LOG_FILE=logs/jira-agent.log

# =============================================================================
# Trigger Configuration
# =============================================================================
TRIGGER_ON_ASSIGNMENT=true
TRIGGER_LABELS=ai-assist,bot
TRIGGER_MENTIONS=@DevBot,@AI

